generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  role           UserRole         @default(USER)
  name           String?
  avatarUrl      String?
  organizationId Int?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  subscriptions  Subscription[]
  customers      Customer[]
  invoices       Invoice[]
  campaigns      Campaign[]
  emailCampaigns EmailCampaign[]
  socialSnippets SocialSnippet[]
  invoiceHistory InvoiceHistory[]
  emailHistory   EmailHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  users     User[]
  brand     BrandSettings?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  status               SubscriptionStatus  @default(trialing)
  plan                 String              @default("trial")
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  activatedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id])
}

model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  invoices  Invoice[]

  @@index([userId, email])
}

model Invoice {
  id         Int           @id @default(autoincrement())
  userId     Int
  customerId Int
  amount     Decimal       @db.Decimal(10, 2)
  status     InvoiceStatus @default(draft)
  dueDate    DateTime?
  description String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id])
  customer   Customer      @relation(fields: [customerId], references: [id])

  @@index([userId])
  @@index([customerId])
}

model EmailCampaign {
  id        Int      @id @default(autoincrement())
  userId    Int
  subject   String
  content   String
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model SocialSnippet {
  id          Int      @id @default(autoincrement())
  userId      Int
  platform    String
  content     String
  sourceUrl   String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([platform])
}

model InvoiceHistory {
  id            Int      @id @default(autoincrement())
  userId        Int
  customerName  String
  customerEmail String?
  recipient     String
  subject       String?
  totalAmount   Decimal  @db.Decimal(12, 2)
  status        String   @default("sent")
  summary       Json?
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sentAt])
}

model EmailHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  recipient  String
  subject    String
  preview    String?
  providerId String?
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sentAt])
}

model BrandSettings {
  id              Int           @id @default(autoincrement())
  organizationId  Int           @unique
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  accentColor     String?
  defaultCTA      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  status      String   @default("draft")
  bannerUrl   String?
  logoUrl     String?
  ctaText     String?
  ctaTargetUrl String?
  bannerBackgroundColor String?
  bannerTextColor String?
  bannerImageOpacity Float?
  bannerCopyText String?
  bannerCopyTextColor String?
  bannerCopyOpacity Float?
  ctaBackgroundColor String?
  ctaTextColor String?
  invoicePageColor String?
  invoiceTextColor String?
  typographyKey String?
  invoiceTemplateKey String?
  invoiceTypographyKey String?
  pageBackgroundColor String?
  pageColor String?
  colorPrimary String?
  colorAccent String?
  fromCompanyName String?
  fromCompanyAddress String?
  fromCompanyEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
