# Core settings
JWT_SECRET=supersecretjwtkey
TRIAL_DAYS=14
API_PORT=4000
WEB_PORT=3000
ADMIN_EMAIL=admin.qa@tmr.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Admin QA
ADMIN_ORG_NAME=The Mossy Roots Admin

# Database
POSTGRES_USER=tmr_admin
POSTGRES_PASSWORD=tmr_password
POSTGRES_DB=tmr_crm

# Stripe
STRIPE_SECRET_KEY=sk_test_yourkey
STRIPE_WEBHOOK_SECRET=whsec_yourkey
STRIPE_PRICE_STARTER=price_starter_test
STRIPE_PRICE_GROWTH=price_growth_test
STRIPE_PRICE_PRO=price_pro_test

# Mail
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
SYSTEM_EMAIL=no-reply@example.com # verified sender used for envelopes/bounces
SMTP_HOST=smtp.example.com # set to your SMTP provider host; leave blank to use Mailpit
SMTP_PORT=465 # match your provider's SMTP port (465=SSL, 587=STARTTLS)
SMTP_SECURE=true # "true" for SMTPS/465, "false" for STARTTLS/587
SMTP_USER=no-reply@example.com # SMTP username/login (often your full email)
SMTP_PASS=change-me # SMTP password or app-specific secret
SMTP_FROM="Example Inc <no-reply@example.com>" # visible From header; must match verified domain
EMAIL_SERVICE=mailpit # change to "gmail" only when using Gmail App Password below
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your-gmail-app-password # use a Gmail App Password, never your primary password

# Application
NEXT_PUBLIC_APP_NAME=TMR CRM
NEXT_PUBLIC_TRIAL_DAYS=14
NEXT_PUBLIC_API_URL=http://localhost:4000
INVOICE_API_URL=http://invoice-api:5000
N8N_WEBHOOK_URL=http://n8n:5678/webhook/social-snippet

# Public API origin used for hosted assets in emails (must be reachable by SendGrid)
API_PUBLIC_URL=http://localhost:4000
